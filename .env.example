PORT=4180
HOST=127.0.0.1
NODE_ENV=development
APP_URL=http://127.0.0.1:4180
DATABASE_PATH=./data/orbit.sqlite
# Defaults to a backups directory beside DATABASE_PATH. Store a separate off-host copy.
BACKUP_DIRECTORY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
YOUTUBE_API_KEY=
GEMINI_API_KEY=
# Set to a video-capable model available in your Google AI Studio project.
GEMINI_MODEL=gemini-2.5-flash
# OAuth redirect URI: APP_URL/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional email provider for account recovery and team invitations.
RESEND_API_KEY=
EMAIL_FROM=
